{
  "name": "todou",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.14"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "tauri dev",
    "dev:drag-lab": "tauri dev --config src-tauri/tauri.drag-lab.conf.json",
    "dev:web": "vite",
    "build": "tauri build --bundles dmg",
    "build:drag-lab": "tauri build --debug --bundles app --no-sign --config src-tauri/tauri.drag-lab.conf.json",
    "build:bundle-assets": "bun scripts/prepare-bundle.ts",
    "build:web": "tsc --noEmit && vite build",
    "pretypecheck": "bun install --frozen-lockfile",
    "typecheck": "tsc --noEmit",
    "pretest": "bun install --frozen-lockfile",
    "test": "vitest run",
    "pretest:watch": "bun install --frozen-lockfile",
    "test:watch": "vitest",
    "pretest:rust": "bun install --frozen-lockfile && bun run build:web && bun run mcp:build",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "presupabase:test": "bun install --frozen-lockfile",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "check": "bun run typecheck && bun run test && bun run test:rust",
    "plugin:validate": "bun scripts/validate-plugin-install.ts",
    "mcp": "bun packages/mcp/src/index.ts",
    "mcp:build": "bun scripts/build-mcp.ts",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:test": "supabase test db",
    "tauri": "tauri"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@supabase/supabase-js": "2.110.7",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-autostart": "2.5.1",
    "@tauri-apps/plugin-global-shortcut": "2.3.2",
    "chrono-node": "2.10.0",
    "lucide-react": "1.25.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "29.1.1",
    "supabase": "2.109.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
