{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Todou",
  "version": "0.1.0",
  "identifier": "com.magicproduct.todou",
  "build": {
    "beforeDevCommand": "bun run mcp:build && bun run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build:bundle-assets",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Todou",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "visible": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "quick-entry",
        "title": "Quick Entry",
        "url": "index.html?window=quick-entry",
        "width": 640,
        "height": 230,
        "center": true,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "resources": {
      "../packages/mcp/dist/todou-mcp": "todou-mcp"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
